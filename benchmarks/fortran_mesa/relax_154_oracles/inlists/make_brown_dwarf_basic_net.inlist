! make_brown_dwarf-style create_initial_model with the default net (basic.net).
! Mirrors the second setup of relax_154
! test_create_initial_model_brown_dwarf_and_prems_15m: same mass, radius,
! initial_z and kap settings as the pp_and_cno_extras setup, no net change.
&star_job
   create_initial_model = .true.
   mass_in_gm_for_create_initial_model = 1.9892d31
   radius_in_cm_for_create_initial_model = 3.5d10
   initial_model_relax_num_steps = 0
   pgstar_flag = .false.
/ ! end of star_job namelist

&eos
/ ! end of eos namelist

&kap
   Zbase = 1d-4
   kap_lowT_prefix = 'lowT_Freedman11'
/ ! end of kap namelist

&controls
   initial_z = 1d-4
/ ! end of controls namelist
